// Unrouted example only. Read security/README.md and audit existing namespaces before deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true
  },
  "name": "lunport-sync-security",
  "main": "src/security/gateway.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "LEGACY_RETIREMENT",
        "class_name": "LegacyRetirementStore"
      },
      {
        "name": "SECURITY_FLOOR",
        "class_name": "SecurityFloorStore"
      },
      {
        "name": "IP_LIMIT",
        "class_name": "IpLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "security-v1",
      "new_sqlite_classes": [
        "LegacyRetirementStore",
        "SecurityFloorStore",
        "IpLimiter"
      ]
    }
  ],
  "vars": {
    "SECURITY_INSTALLATION": "00000000000000000000000000000000",
    "CENTRAL_ORIGIN": "https://sync.example.invalid"
  }
}
