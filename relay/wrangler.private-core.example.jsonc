// Fresh-install unrouted example only; never replace an existing migration history with this file.
// Existing namespaces require the explicit authority transfer/import procedure in security/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true
  },
  "name": "sshelter-relay",
  "main": "src/index.ts",
  "build": {
    "command": "node scripts/build-passkey-page.mjs"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAIN",
        "class_name": "ChainStore"
      },
      {
        "name": "IP_LIMIT",
        "class_name": "IpLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChainStore", "IpLimiter"]
    }
  ],
  "vars": {
    "CENTRAL_PRIVATE_CORE": "1"
  }
}
