// Unrouted example only. Read security/README.md and audit existing namespaces before deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true
  },
  "name": "sshelter-relay",
  "main": "src/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAIN",
        "class_name": "ChainStore"
      },
      {
        "name": "IP_LIMIT",
        "class_name": "IpLimiter"
      },
      {
        "name": "ACCOUNT",
        "class_name": "AccountStore"
      },
      {
        "name": "VAULT",
        "class_name": "VaultStore"
      },
      {
        "name": "LEGACY_RETIREMENT",
        "class_name": "LegacyRetirementStore",
        "script_name": "lunport-sync-security"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChainStore",
        "IpLimiter"
      ]
    },
    {
      "tag": "v2-central",
      "new_sqlite_classes": [
        "AccountStore",
        "VaultStore"
      ]
    }
  ],
  "vars": {
    "CENTRAL_PRIVATE_CORE": "1",
    "CENTRAL_ENABLED": "0",
    "CENTRAL_ORIGIN": "https://sync.example.invalid",
    "OIDC_ISSUER": "https://identity.example.invalid",
    "OIDC_JWKS_URL": "https://identity.example.invalid/.well-known/jwks.json",
    "OIDC_API_AUDIENCE": "lunport-sync",
    "OIDC_NATIVE_CLIENT_ID": "lunport-native",
    "OIDC_SYNC_SCOPE": "lunport:sync"
  }
}
