{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sshelter-relay",
  "main": "src/index.ts",
  // ≥ 2026-02-24:deleteAll() 連 alarm 一起刪,destroy/alarm 不用再各自 deleteAlarm()。
  "compatibility_date": "2026-08-20",
  "durable_objects": {
    "bindings": [
      { "name": "CHAIN", "class_name": "ChainStore" },
      { "name": "IP_LIMIT", "class_name": "IpLimiter" },
      { "name": "LEGACY_RETIREMENT", "class_name": "LegacyRetirementStore" },
      { "name": "ACCOUNT", "class_name": "AccountStore" },
      { "name": "VAULT", "class_name": "VaultStore" },
      { "name": "PASSKEY", "class_name": "PasskeyStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChainStore", "IpLimiter"] },
    {
      "tag": "v2-central",
      "new_sqlite_classes": ["AccountStore", "VaultStore"],
    },
    {
      "tag": "v3-legacy-fence",
      "new_sqlite_classes": ["LegacyRetirementStore"],
    },
    { "tag": "v4-passkey-auth", "new_sqlite_classes": ["PasskeyStore"] },
  ],
  "observability": { "enabled": true },
}
