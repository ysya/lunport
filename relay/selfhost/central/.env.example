# New-install preview only. Existing relay namespaces need reviewed import/restore first.
RELAY_DOMAIN=sync.example.invalid
# Generate each once and preserve them with the complete storage backup:
# openssl rand -hex 16
SECURITY_INSTALLATION=
# openssl rand -hex 32
SELFHOST_PROXY_KEY=
# Intentionally disabled until deployment and native migration checks are complete.
CENTRAL_ENABLED=0
PASSKEY_ENABLED=1
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_API_AUDIENCE=lunport-sync
OIDC_NATIVE_CLIENT_ID=lunport-native
OIDC_SYNC_SCOPE=lunport:sync
# Security and app artifacts are updated independently.
SECURITY_IMAGE=lunport-central-security:local
CORE_IMAGE=lunport-central-core:local

# Offline import/checkpoint utility; no public listener.
AUTHORITY_OPERATOR_IMAGE=lunport-central-authority-operator:local
