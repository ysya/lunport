{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunport",
  "version": "1.10.1",
  "identifier": "org.homelab.sshelter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lunport",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Lunport — Your SSH workspace",
    "macOS": {
      "hardenedRuntime": true
    },
    "windows": {
      "wix": {
        "upgradeCode": "d00b09d3-45df-5130-b6d5-52034e820843",
        "template": "installers/main.wxs"
      },
      "nsis": {
        "template": "installers/nsis.nsi",
        "installerHooks": "installers/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "provides": [
          "ss-helter"
        ],
        "conflicts": [
          "ss-helter"
        ],
        "replaces": [
          "ss-helter"
        ]
      },
      "rpm": {
        "provides": [
          "ss-helter"
        ],
        "obsoletes": [
          "ss-helter"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEMkUwQUEzMzNDNTA3QzMKUldUREI4VXpvd291ZlJQU1FKcmt1MlpiZW9nQ1N3NjIyNUJwSlV2RjV0dWJ2UUtQdmV5UUEvdGIK",
      "endpoints": [
        "https://github.com/ysya/lunport/releases/latest/download/latest.json"
      ]
    }
  }
}
