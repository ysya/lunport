{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "org.homelab.sshelter.dev",
  "productName": "SSHelter Dev",
  "app": {
    "windows": [
      {
        "title": "SSHelter Dev",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
